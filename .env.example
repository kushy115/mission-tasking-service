# Service
MTS_ENV=local
MTS_LOG_LEVEL=INFO
MTS_HOST=0.0.0.0
MTS_PORT=8000

# LLM provider — pick ONE row and set MTS_LLM_PROVIDER + MTS_LLM_MODEL accordingly.
# Same API_KEY var works for all providers; the code routes by MTS_LLM_PROVIDER.
#   anthropic     → claude-haiku-4-5 | claude-sonnet-4-6 | claude-opus-4-7      (key: sk-ant-...)
#   openai        → gpt-4o-mini | gpt-4o                                        (key: sk-...)
#   google_genai  → gemini-2.5-flash-lite | gemini-2.5-flash | gemini-2.5-pro   (key: AIzaSy...)
API_KEY=
MTS_LLM_PROVIDER=anthropic
MTS_LLM_MODEL=claude-haiku-4-5
MTS_LLM_TEMPERATURE=0.0
MTS_LLM_MAX_TOKENS=4096
MTS_LLM_TIMEOUT_S=60

# Planning-effort tiers (see docs/DESIGN_DECISIONS.md DD-017). The tier changes
# only the model + whether the tool-calling agent runs — all safety calculations
# are identical. "fast" = 1 direct LLM call (rate-limit friendly, ~same speed as
# a plain chat call); "balanced"/"thorough" = the grounding agent (~4-6+ calls
# per drone → needs healthy API rate limits or it will be slow). The per-tier
# models must match MTS_LLM_PROVIDER (defaults below are Anthropic ids); a blank
# value falls back to MTS_LLM_MODEL.
MTS_DEFAULT_PLANNING_EFFORT=balanced
MTS_PLAN_MODEL_FAST=claude-haiku-4-5
MTS_PLAN_MODEL_BALANCED=
MTS_PLAN_MODEL_THOROUGH=claude-opus-4-8

# Repair / safety bounds
MTS_REPAIR_LOOP_CAP=3
MTS_BATTERY_RESERVE_MIN_PCT=20.0
MTS_MIN_AGL_M=20.0

# Postgres / PostGIS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mts
POSTGRES_USER=mts
POSTGRES_PASSWORD=mts
MTS_DATABASE_URL=postgresql+psycopg://mts:mts@postgres:5432/mts
MTS_CHECKPOINT_DATABASE_URL=postgresql://mts:mts@postgres:5432/mts

# Redis
REDIS_URL=redis://redis:6379/0

# LangSmith (LLM tracing) — leave TRACING=false unless you have a real key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mts-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mission-tasking-service
OTEL_TRACES_EXPORTER=otlp

# Weather (optional real provider; default synthetic)
MTS_WEATHER_PROVIDER=synthetic
MTS_WEATHER_SEED=42
