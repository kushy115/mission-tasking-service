# Service
MTS_ENV=local
MTS_LOG_LEVEL=INFO
MTS_HOST=0.0.0.0
MTS_PORT=8000

# LLM provider — pick one and set MTS_LLM_PROVIDER + MTS_LLM_MODEL accordingly.
#   google_genai  → gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash
#   anthropic     → claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5
#   openai        → gpt-4o | gpt-4o-mini
API_KEY=
MTS_LLM_PROVIDER=google_genai
MTS_LLM_MODEL=gemini-2.5-flash-lite
MTS_LLM_TEMPERATURE=0.0
MTS_LLM_MAX_TOKENS=4096
MTS_LLM_TIMEOUT_S=60

# Repair / safety bounds
MTS_REPAIR_LOOP_CAP=3
MTS_BATTERY_RESERVE_MIN_PCT=20.0
MTS_MIN_AGL_M=20.0

# Postgres / PostGIS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mts
POSTGRES_USER=mts
POSTGRES_PASSWORD=mts
MTS_DATABASE_URL=postgresql+psycopg://mts:mts@postgres:5432/mts
MTS_CHECKPOINT_DATABASE_URL=postgresql://mts:mts@postgres:5432/mts

# Redis
REDIS_URL=redis://redis:6379/0

# LangSmith (LLM tracing) — leave TRACING=false unless you have a real key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mts-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mission-tasking-service
OTEL_TRACES_EXPORTER=otlp

# Weather (optional real provider; default synthetic)
MTS_WEATHER_PROVIDER=synthetic
MTS_WEATHER_SEED=42
