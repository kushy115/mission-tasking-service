{
  "title": "MTS — Mission Tasking Service",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Compile latency p50/p95/p99",
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(mts_compile_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(mts_compile_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(mts_compile_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Compile rate by status",
      "targets": [
        {"expr": "sum by (status) (rate(mts_compile_requests_total[5m]))", "legendFormat": "{{status}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Repair loops (avg)",
      "targets": [
        {"expr": "rate(mts_repair_loops_sum[5m]) / rate(mts_repair_loops_count[5m])", "legendFormat": "avg loops"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens by node",
      "targets": [
        {"expr": "sum by (node) (rate(mts_tokens_total[5m]))", "legendFormat": "{{node}}"}
      ]
    }
  ]
}
